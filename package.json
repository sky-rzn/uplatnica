    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsqr": "^1.4.0",
    "preact-render-to-string": "^6.8.3",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.7",
    "pdf-lib": "^1.17.1",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4"
